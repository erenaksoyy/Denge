{
  "expo": {
    "name": "Denge",
    "slug": "denge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "denge",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.erenaksoy.denge"
    },
    "android": {
      "package": "com.erenaksoy.denge",
      "adaptiveIcon": {
        "backgroundColor": "#111113",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "locales": {
      "tr": "./locales/tr.json",
      "en": "./locales/en.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F3F5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Denge uses the camera to photograph your meals and scan barcodes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Denge uses your photos so you can analyze a meal photo you already took.",
          "cameraPermission": "Denge uses the camera to photograph your meals and scan barcodes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
