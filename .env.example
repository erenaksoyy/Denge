# Copy this file to .env.local and fill in your key. .env.local is ignored by git.
# Get a free Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model overrides
# GEMINI_MODEL=gemini-3.8-flash            # photo analysis and the AI dietitian
# GEMINI_TEXT_MODEL=gemini-3.5-flash-lite  # text estimates, fixes and exercise

# Set to 1 to try the app with sample AI answers and no key
AI_MOCK=0
